APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://jb_bridge:local_development_only@localhost:5432/jb_bridge
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=15
CONSULTATION_RATE_LIMIT=10
CONSULTATION_CACHE_SECONDS=600
DAILY_AI_CALL_LIMIT=200
IDENTIFIER_SALT=replace-with-a-random-secret
DATABASE_ENABLED=true
DATABASE_CONNECT_TIMEOUT=2
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512
VECTOR_SIMILARITY_THRESHOLD=0.55
DOCUMENT_MAX_BYTES=5000000
RAG_TOP_K=6
RAG_SIMILARITY_THRESHOLD=0.35
RAG_WEIGHT_LEXICAL=1.0
RAG_WEIGHT_VECTOR=1.0
RAG_WEIGHT_AUTHORITY=0.15
RAG_WEIGHT_FRESHNESS=0.05
RAG_MAX_EVIDENCE=4
RAG_MAX_CHUNKS_PER_DOCUMENT=2
RAG_MIN_CONFIDENT_RELEVANCE=0.35
RAG_QUERY_REWRITE_ENABLED=false
RAG_DEBUG_ENABLED=false
RAG_ALLOWED_DOMAINS=law.go.kr,open.law.go.kr,moj.go.kr,immigration.go.kr,hikorea.go.kr,moel.go.kr,minimumwage.go.kr,nlrc.go.kr,comwel.or.kr,jeonbuk.go.kr,liveinkorea.kr,gov.kr
RAG_INDEX_VERSION=1
RAG_ADMIN_TOKEN=
RAG_UPDATE_ENABLED=true
SOURCE_FETCH_TIMEOUT=15
SOURCE_MAX_RESPONSE_BYTES=5000000
SOURCE_MAX_REDIRECTS=3
SOURCE_CHECK_INTERVAL_LAW=86400
SOURCE_CHECK_INTERVAL_NOTICE=21600
SOURCE_CHECK_INTERVAL_GUIDE=604800
SOURCE_STALE_WARNING_DAYS=14
